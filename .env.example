# ─── Deel MCP Server Configuration ──────────────────────────────────────────

# Required: Your Deel API key
# Get it from: Deel Settings > Integrations > API Tokens
DEEL_API_KEY=your_deel_api_key_here

# Optional: Override the Deel API base URL (default: https://app.deel.com/api)
# DEEL_BASE_URL=https://app.deel.com/api
